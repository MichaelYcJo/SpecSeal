#!/usr/bin/env sh
# Carries `fold-check` as a bare command instead of a long path into the
# plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH
# while the plugin is enabled, so `skills/settle/SKILL.md` can print a command
# a reader can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   fold-check                     fold-check --shape-from 0
#   fold-check --ceiling 1000
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/settle/scripts/fold_check.py" "$@"
