#!/usr/bin/env sh
# Prints the seal the broad gate stamps, as `seal-stamp` instead of a long
# path into the plugin directory. Claude Code puts a plugin's bin/ on the Bash
# tool's PATH while the plugin is enabled, so a person can type it and see the
# drawing without a gate having run. With `--from`, it draws a sealed run's
# values file once, for a run no hook drew. It is not how a session ends a
# segment: the session that spawned the sealer has the stamp drawn for it at
# the end of its turn.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through, and the default scale
# is 0.90:
#   seal-stamp                    seal-stamp --shape
#   seal-stamp --scale 0.75       seal-stamp --shape --scale 0.75
#   seal-stamp --from <file>      seal-stamp --shape --from <file>
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/verify/scripts/seal_stamp.py" "$@"
