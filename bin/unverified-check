#!/usr/bin/env sh
# Runs the unverified-record reader as `unverified-check` instead of a long
# path into the plugin directory. Claude Code puts a plugin's bin/ on the Bash
# tool's PATH while the plugin is enabled, so the README can print a command a
# reader can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   unverified-check .            unverified-check specs/
#   unverified-check --baseline origin/main .
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/verify/scripts/unverified_check.py" "$@"
