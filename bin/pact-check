#!/usr/bin/env sh
# Runs the pact reconciliation as `pact-check` instead of a long
# path into the plugin directory. Claude Code puts a plugin's bin/ on the Bash
# tool's PATH while the plugin is enabled, so a document can print a command a
# reader can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   pact-check                in the pact's repository
#   pact-check /Users/x/work/orders-api
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/evidence-check/scripts/pact_check.py" "$@"
