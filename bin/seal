#!/usr/bin/env sh
# Carries a local-mode `seal/` root between clones, as `seal` instead of a
# long path into the plugin directory. Claude Code puts a plugin's bin/ on the
# Bash tool's PATH while the plugin is enabled, so the README can print a
# command a reader can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   seal export                   seal export --check
#   seal export --output ~/keys   seal import seal-repo-2026-09-03.zip
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/implement/scripts/seal.py" "$@"
