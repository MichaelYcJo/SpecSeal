#!/usr/bin/env sh
# Runs the ledger drift check as `evidence-check` instead of a long path into
# the plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's
# PATH while the plugin is enabled, so the README can print a command a reader
# can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   evidence-check .              evidence-check . --strict
#   evidence-check --ledger SPEC.md .
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/evidence-check/scripts/evidence_check.py" "$@"
