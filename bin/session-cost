#!/usr/bin/env sh
# Runs the session cost report as `session-cost` instead of a long path into
# the plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's
# PATH while the plugin is enabled, so the README can print a command a reader
# can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   session-cost --latest         session-cost --latest /path/to/repo
#   session-cost <transcript.jsonl>            session-cost --json <transcript>
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/verify/scripts/session_cost.py" "$@"
