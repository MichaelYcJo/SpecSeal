#!/usr/bin/env sh
# Runs the surviving-wording check as `survivor-check` instead of a long path
# into the plugin directory. Claude Code puts a plugin's bin/ on the Bash
# tool's PATH while the plugin is enabled, so a fix pass can type the command
# a document names.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   survivor-check --range a1b2c3d..HEAD
#   survivor-check --range origin/main...HEAD --exempt seal/specs/<id>/survivors.md
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/code-review/scripts/survivor_check.py" "$@"
