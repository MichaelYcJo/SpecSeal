#!/usr/bin/env sh
# Runs the one broad gate as `broad-gate` instead of a long path into the
# plugin directory. Claude Code puts a plugin's bin/ on the Bash tool's PATH
# while the plugin is enabled, so the sealer's definition can name a command
# it can actually type.
#
# Resolves the script relative to this file, not the caller's cwd, so it works
# from any directory. Arguments pass straight through:
#   broad-gate --base origin/main                broad-gate --base origin/main --shape
#   broad-gate --base origin/main --record seal/specs/<work-item-id>
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
exec python3 "$here/../skills/verify/scripts/broad_gate.py" "$@"
